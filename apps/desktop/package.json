{
  "name": "@tjournal/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "pnpm build && electron-builder --dir",
    "make": "pnpm build && electron-builder --win nsis"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.12",
    "@tjournal/journal": "workspace:*",
    "@tjournal/platform-configuration": "workspace:*",
    "@tjournal/platform-database": "workspace:*",
    "@tjournal/platform-errors": "workspace:*",
    "@tjournal/platform-observability": "workspace:*",
    "awilix": "^13.0.5",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "1.0.0-rc.4",
    "i18next": "^26.4.2",
    "lucide-react": "^1.45.0",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.13",
    "zod": "^4.6.2"
  },
  "build": {
    "appId": "com.tjournal.desktop",
    "productName": "TJournal",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0"
  }
}
