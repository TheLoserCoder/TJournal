{
  "name": "@tjournal/desktop",
  "version": "1.0.1",
  "private": true,
  "description": "Offline desktop trading journal",
  "author": "TheLoserCoder",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "pnpm build && electron-builder --dir",
    "make": "pnpm build && electron-builder --win nsis"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.12",
    "@tjournal/account": "workspace:*",
    "@tjournal/analytics": "workspace:*",
    "@tjournal/instrument": "workspace:*",
    "@tjournal/journal": "workspace:*",
    "@tjournal/platform-configuration": "workspace:*",
    "@tjournal/platform-database": "workspace:*",
    "@tjournal/platform-errors": "workspace:*",
    "@tjournal/platform-observability": "workspace:*",
    "@tjournal/tag": "workspace:*",
    "@tjournal/trade": "workspace:*",
    "awilix": "^13.0.5",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.45.0",
    "pino": "^10.3.1",
    "piscina": "^5.3.2",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "recharts": "^3.10.1",
    "zod": "^4.6.2"
  },
  "build": {
    "appId": "com.tjournal.desktop",
    "productName": "TJournal",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0"
  }
}
